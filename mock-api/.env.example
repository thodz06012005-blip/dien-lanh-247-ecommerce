# Copy to .env for local Mock development. Never reuse these values in production.
PORT=3001
NODE_ENV=development
SERVICE_ONLY=true

ENABLE_DEV_ENDPOINTS=true
ENABLE_DEMO_ACCOUNTS=true
DEMO_ADMIN_EMAIL=owner@dienlanh247.vn
DEMO_ADMIN_PASSWORD=Admin@123456
DEMO_ADMIN2_EMAIL=admin@dienlanh247.vn
DEMO_ADMIN2_PASSWORD=Admin@456789
DEMO_STAFF_EMAIL=staff@dienlanh247.vn
DEMO_STAFF_PASSWORD=Staff@789012
TECHNICIAN_DEMO_PIN=123456

CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://127.0.0.1:5174,http://127.0.0.1:5173
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_PER_EMAIL=5
LOGIN_RATE_LIMIT_MAX_PER_IP=20
LOGIN_RATE_LIMIT_MAX_PER_IP_EMAIL=5
LOGIN_RATE_LIMIT_LOCK_MS=900000
TRUST_PROXY=false
MOCK_JSON_BODY_LIMIT=1mb
MOCK_URLENCODED_BODY_LIMIT=100kb
AUDIT_LOG_ENABLED=true
AUDIT_LOG_MAX_ENTRIES=1000
AUDIT_LOG_CAPTURE_FAILED_LOGIN=true
AUDIT_LOG_CAPTURE_RBAC_DENIED=true
DANGEROUS_ACTION_CONFIRMATION_REQUIRED=true
SOFT_DELETE_ENABLED=true
